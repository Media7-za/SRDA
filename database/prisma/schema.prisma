// ─────────────────────────────────────────────────────────────────────
// Restaurant Direct — MVP Database Schema
// Source of truth: /ai/architecture.md, /ai/implementation_decisions.md, /docs/PRD_Core.md
// Frozen for MVP after initial migration. Changes require architecture review.
// ─────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════
// ENUMS — Canonical values from architecture.md §3.7, §5.1, §5.2
// ═══════════════════════════════════════════════════════════════════

enum UserRole {
  platform_admin
  restaurant_owner
  restaurant_staff
  driver
  customer
}

enum OrderStatus {
  pending
  confirmed
  preparing
  ready_for_pickup
  out_for_delivery
  delivered
  cancelled
}

enum FulfillmentType {
  delivery
  pickup
}

enum OrderPaymentStatus {
  unpaid
  paid
}

enum PaymentStatus {
  pending
  processing
  succeeded
  failed
  refunded
}

enum PaymentProvider {
  stripe
  in_store
}

enum PaymentMethod {
  card_online
  cash
  card_in_store
}

enum DeliveryStatus {
  unassigned
  assigned
  picked_up
  on_the_way
  delivered
  failed
}

// ═══════════════════════════════════════════════════════════════════
// TABLE 1: Users (Auth Module)
// Soft delete via deleted_at. Never hard-delete users with orders.
// ═══════════════════════════════════════════════════════════════════

model User {
  id                String    @id @default(uuid())
  name              String
  email             String    @unique
  phone             String?
  passwordHash      String    @map("password_hash")
  role              UserRole  @default(customer)
  restaurantId      String?   @map("restaurant_id")
  isActive          Boolean   @default(true) @map("is_active")
  mustResetPassword Boolean   @default(false) @map("must_reset_password")
  managerPin        String?   @map("manager_pin")
  deletedAt         DateTime? @map("deleted_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  // Relations
  addresses         Address[]
  orders            Order[]
  driver            Driver?
  paymentsCollected Payment[] @relation("PaymentCollector")

  @@index([restaurantId, role])
  @@map("users")
}

// ═══════════════════════════════════════════════════════════════════
// TABLE 2: Addresses (Auth Module)
// Multiple per user. Lat/lng for delivery distance calculation.
// No restaurant_id — user-owned, not restaurant-scoped.
// ═══════════════════════════════════════════════════════════════════

model Address {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  label      String? // e.g. "Home", "Work"
  street     String
  city       String
  postalCode String   @map("postal_code")
  latitude   Decimal  @db.Decimal(10, 7)
  longitude  Decimal  @db.Decimal(10, 7)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relations
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@map("addresses")
}

// ═══════════════════════════════════════════════════════════════════
// TABLE 3: Restaurants (Menu Module)
// is_active serves as soft delete. RESTRICT deletion if orders exist.
// ═══════════════════════════════════════════════════════════════════

model Restaurant {
  id                      String    @id @default(uuid())
  name                    String
  description             String?
  phone                   String?
  email                   String?
  address                 String?
  openingHours            Json      @map("opening_hours")
  status                  String    @default("inactive")
  isActive                Boolean   @default(true) @map("is_active")
  features                Json?
  defaultReadyTimeMinutes Int       @default(20) @map("default_ready_time_minutes")
  logoUrl                 String?   @map("logo_url")
  suspensionReason        String?   @map("suspension_reason")
  suspendedAt             DateTime? @map("suspended_at")
  suspendedBy             String?   @map("suspended_by")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  // Relations
  menuCategories MenuCategory[]
  menuItems      MenuItem[]
  orders         Order[]
  deliveries     Delivery[]

  @@index([status])
  @@map("restaurants")
}

// ═══════════════════════════════════════════════════════════════════
// TABLE 4: Menu Categories (Menu Module)
// ═══════════════════════════════════════════════════════════════════

model MenuCategory {
  id           String   @id @default(uuid())
  restaurantId String   @map("restaurant_id")
  name         String
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItems  MenuItem[]

  @@index([restaurantId])
  @@map("menu_categories")
}

// ═══════════════════════════════════════════════════════════════════
// TABLE 5: Menu Items (Menu Module)
// is_available used as soft delete flag. Price is Decimal for precision.
// ═══════════════════════════════════════════════════════════════════

model MenuItem {
  id           String   @id @default(uuid())
  restaurantId String   @map("restaurant_id")
  categoryId   String?  @map("category_id") // Nullable: SET NULL on category delete
  name         String
  description  String?
  price        Decimal  @db.Decimal(10, 2)
  imageUrl     String?  @map("image_url")
  isAvailable  Boolean  @default(true) @map("is_available")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  restaurant     Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category       MenuCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  modifierGroups MenuModifierGroup[]
  orderItems     OrderItem[]

  @@index([restaurantId])
  @@index([categoryId])
  @@map("menu_items")
}

// ═══════════════════════════════════════════════════════════════════
// TABLE 6: Menu Modifier Groups & Options (Menu Module)
// Replaces flat MenuItemOptions with grouped modifier structure
// ═══════════════════════════════════════════════════════════════════

model MenuModifierGroup {
  id         String  @id @default(uuid())
  menuItemId String  @map("menu_item_id")
  name       String
  required   Boolean @default(false)
  maxSelect  Int?    @map("max_select")

  // Relations
  menuItem MenuItem             @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  options  MenuModifierOption[]

  @@index([menuItemId])
  @@map("menu_modifier_groups")
}

model MenuModifierOption {
  id         String @id @default(uuid())
  groupId    String @map("group_id")
  name       String
  priceDelta Int?   @map("price_delta")

  // Relations
  group            MenuModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  orderItemOptions OrderItemOption[]

  @@index([groupId])
  @@map("menu_modifier_options")
}

// ═══════════════════════════════════════════════════════════════════
// TABLE 7: Orders (Order Module)
// Central transaction record. Snapshot totals stored at creation.
// NEVER deleted. restaurant_id for future multi-restaurant SaaS.
// ═══════════════════════════════════════════════════════════════════

model Order {
  id              String             @id @default(uuid())
  version         Int                @default(1)
  customerId      String             @map("customer_id")
  restaurantId    String             @map("restaurant_id")
  addressId       String?            @map("address_id") // Nullable for collection orders
  status          OrderStatus        @default(pending)
  fulfillmentType FulfillmentType    @map("fulfillment_type")
  paymentStatus   OrderPaymentStatus @default(unpaid) @map("payment_status")

  // Snapshot totals — stored at creation, never recomputed
  subtotal    Decimal  @db.Decimal(10, 2)
  deliveryFee Decimal? @map("delivery_fee") @db.Decimal(10, 2)
  taxAmount   Decimal  @map("tax_amount") @db.Decimal(10, 2)
  totalAmount Decimal  @map("total_amount") @db.Decimal(10, 2)

  // Dashboard projections
  itemCount           Int       @default(0) @map("item_count")
  customerNote        String?   @map("customer_note")
  specialInstructions String?   @map("special_instructions")
  estimatedReadyAt    DateTime? @map("estimated_ready_at")

  // Delivery distance snapshot — null for pickup orders
  deliveryDistanceMeters Int?    @map("delivery_distance_meters")
  deliveryFeeBand        String? @map("delivery_fee_band") // e.g. "0-5km"

  // Idempotency
  idempotencyKey String? @unique @map("idempotency_key")

  // Cancellations
  cancellationReason String?   @map("cancellation_reason")
  cancelledByUserId  String?   @map("cancelled_by_user_id")
  cancelledAt        DateTime? @map("cancelled_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  customer      User                 @relation(fields: [customerId], references: [id], onDelete: Restrict)
  restaurant    Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  address       Address?             @relation(fields: [addressId], references: [id], onDelete: SetNull)
  orderItems    OrderItem[]
  payments      Payment[]
  delivery      Delivery?
  statusHistory OrderStatusHistory[]

  @@index([customerId])
  @@index([restaurantId])
  @@index([status])
  @@index([restaurantId, status, updatedAt])
  @@index([id, version])
  @@map("orders")
}

// ═══════════════════════════════════════════════════════════════════
// TABLE 8: Order Items (Order Module)
// SNAPSHOT FIELDS: item_name, item_price, line_total are copied at
// purchase time. Historical orders NEVER change if menu prices change.
// ═══════════════════════════════════════════════════════════════════

model OrderItem {
  id         String  @id @default(uuid())
  orderId    String  @map("order_id")
  menuItemId String  @map("menu_item_id") // Reference for analytics only
  itemName   String  @map("item_name") // SNAPSHOT
  itemPrice  Decimal @map("item_price") @db.Decimal(10, 2) // SNAPSHOT
  quantity   Int
  lineTotal  Decimal @map("line_total") @db.Decimal(10, 2) // SNAPSHOT: item_price * qty + options

  // Relations
  order    Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem          @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  options  OrderItemOption[]

  @@index([orderId])
  @@map("order_items")
}

// ═══════════════════════════════════════════════════════════════════
// TABLE 9: Order Item Options (Order Module)
// SNAPSHOT FIELDS: option_name, option_price are copied at purchase.
// ═══════════════════════════════════════════════════════════════════

model OrderItemOption {
  id                     String  @id @default(uuid())
  orderItemId            String  @map("order_item_id")
  sourceModifierOptionId String? @map("source_modifier_option_id") // Analytics only, nullable
  optionName             String  @map("option_name") // SNAPSHOT
  optionPrice            Decimal @map("option_price") @db.Decimal(10, 2) // SNAPSHOT

  // Relations
  orderItem            OrderItem           @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  sourceModifierOption MenuModifierOption? @relation(fields: [sourceModifierOptionId], references: [id], onDelete: SetNull)

  @@index([orderItemId])
  @@map("order_item_options")
}

// ═══════════════════════════════════════════════════════════════════
// TABLE 10: Payments (Payment Module)
// ═══════════════════════════════════════════════════════════════════

model Payment {
  id                String          @id @default(uuid())
  orderId           String          @map("order_id")
  provider          PaymentProvider
  method            PaymentMethod
  providerPaymentId String?         @map("provider_payment_id") // Stripe PI id, null for in-store
  amount            Decimal         @db.Decimal(10, 2)
  currency          String          @default("ZAR") @db.VarChar(3)
  status            PaymentStatus   @default(pending)

  // In-store accountability fields (null for Stripe payments)
  collectedByUserId String?   @map("collected_by_user_id")
  collectedAt       DateTime? @map("collected_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  order       Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  collectedBy User? @relation("PaymentCollector", fields: [collectedByUserId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("payments")
}

// ═══════════════════════════════════════════════════════════════════
// TABLE 11: Drivers (Delivery Module)
// ═══════════════════════════════════════════════════════════════════

model Driver {
  id           String  @id @default(uuid())
  userId       String  @unique @map("user_id") // 1:1 with User
  restaurantId String  @map("restaurant_id")
  vehicleType  String? @map("vehicle_type")
  isAvailable  Boolean @default(false) @map("is_available")

  // Current location
  latitude       Decimal?  @map("latitude") @db.Decimal(10, 7)
  longitude      Decimal?  @map("longitude") @db.Decimal(10, 7)
  lastLocationAt DateTime? @map("last_location_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user            User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  deliveries      Delivery[]
  locationHistory DriverLocation[]
  devices         DriverDevice[]

  @@index([restaurantId, isAvailable])
  @@map("drivers")
}

// ═══════════════════════════════════════════════════════════════════
// TABLE 12: Deliveries (Delivery Module)
// ═══════════════════════════════════════════════════════════════════

model Delivery {
  id            String         @id @default(uuid())
  orderId       String         @unique @map("order_id") // 1:1 with Order
  driverId      String?        @map("driver_id") // Nullable until assigned
  restaurantId  String         @map("restaurant_id")
  status        DeliveryStatus @default(unassigned)
  failureReason String?        @map("failure_reason")
  pickedUpAt    DateTime?      @map("picked_up_at")
  deliveredAt   DateTime?      @map("delivered_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  // Relations
  order      Order      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  driver     Driver?    @relation(fields: [driverId], references: [id], onDelete: Restrict)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)

  @@index([driverId])
  @@index([restaurantId])
  @@map("deliveries")
}

// ═══════════════════════════════════════════════════════════════════
// TABLE 13: Driver Locations (Delivery Module)
// ═══════════════════════════════════════════════════════════════════

model DriverLocation {
  id         String   @id @default(uuid())
  driverId   String   @map("driver_id")
  deliveryId String?  @map("delivery_id") // Nullable
  latitude   Decimal  @db.Decimal(10, 7)
  longitude  Decimal  @db.Decimal(10, 7)
  accuracy   Float?
  timestamp  DateTime @default(now())

  // Relations
  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId, timestamp])
  @@map("driver_locations")
}

// ═══════════════════════════════════════════════════════════════════
// TABLE 14: Order Status History (Order Module)
// ═══════════════════════════════════════════════════════════════════

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String      @map("order_id")
  status    OrderStatus
  changedBy String?     @map("changed_by") // user_id of staff, null for system
  note      String? // Optional reason for transition
  createdAt DateTime    @default(now()) @map("created_at")

  // Relations
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

// ═══════════════════════════════════════════════════════════════════
// TABLE 15: Driver Devices (Delivery Module)
// ═══════════════════════════════════════════════════════════════════

model DriverDevice {
  id         String   @id @default(uuid())
  driverId   String   @map("driver_id")
  fcmToken   String   @map("fcm_token")
  deviceType String   @map("device_type")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  driver Driver @relation(fields: [driverId], references: [id])

  @@index([driverId])
  @@map("driver_devices")
}

// ═══════════════════════════════════════════════════════════════════
// TABLE 16: Driver Earnings Config (Delivery Module)
// ═══════════════════════════════════════════════════════════════════

model DriverEarningsConfig {
  id                 String   @id @default(uuid())
  tenantId           String   @map("tenant_id")
  flatFeePerDelivery Int      @map("flat_fee_per_delivery")
  currency           String   @default("ZAR")
  active             Boolean  @default(true)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("driver_earnings_config")
}

// ═══════════════════════════════════════════════════════════════════
// TABLE 17: Board Events (Realtime Outbox)
// ═══════════════════════════════════════════════════════════════════

model BoardEvent {
  id                  String   @id @default(uuid())
  restaurantId        String   @map("restaurant_id")
  entity              String   @default("order")
  event               String
  orderId             String   @map("order_id")
  occurredAt          DateTime @default(now()) @map("occurred_at")
  versionUpdatedAtISO String   @map("version_updated_at_iso")
  payload             Json

  @@index([restaurantId, occurredAt])
  @@map("board_events")
}

